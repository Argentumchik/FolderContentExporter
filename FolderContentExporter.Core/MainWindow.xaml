<Window x:Class="FolderContentExporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Folder Content Exporter"
        Height="500" Width="800" 
        MinHeight="400" MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <!-- Главный Grid. Margin 10 дает аккуратный отступ от краев окна всему интерфейсу -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- Строка 0: Путь (займет минимум места) -->
            <RowDefinition Height="*" />
            <!-- Строка 1: Таблица и меню (займет всё свободное место) -->
            <RowDefinition Height="Auto" />
            <!-- Строка 2: Кнопки и прогресс (займет минимум места) -->
        </Grid.RowDefinitions>

        <!-- === СТРОКА 0: Информация о пути === -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Path:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectedFolder}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <!-- === СТРОКА 1: Основная рабочая область === -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130" />
                <!-- Левое меню -->
                <ColumnDefinition Width="*" />
                <!-- Таблица -->
            </Grid.ColumnDefinitions>

            <!-- Левая панель с инструментами -->
            <!-- StackPanel автоматически укладывает элементы друг под друга -->
            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                <Button Content="Open folder" Command="{Binding SelectFolderCommand}" Padding="0,8" Margin="0,0,0,10"/>
                <CheckBox Content="Include sub" IsChecked="{Binding SubfoldersIncluded, Mode=TwoWay}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Основная таблица -->
            <!-- Занимает всю ширину (Column="1") и высоту (*) -->
            <DataGrid Grid.Column="1" 
                      ItemsSource="{Binding Files}" 
                      AutoGenerateColumns="False" 
                      IsReadOnly="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="Auto" />
                    <!-- Width="*" растянет колонку Имя -->
                    <DataGridTextColumn Header="Размер" SortMemberPath="Size" Binding="{Binding SizeDisplay}" Width="Auto" />
                    <DataGridTextColumn Header="Расширение" Binding="{Binding Extension}" Width="Auto" />
                    <DataGridTextColumn Header="Путь" Binding="{Binding Path}" Width="Auto" />
                    <!-- Путь обычно длинный, даем ему больше места -->
                    <DataGridTextColumn Header="Создан" Binding="{Binding Created}" />
                    <DataGridTextColumn Header="Изменён" Binding="{Binding Modified}" />
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- === СТРОКА 2: Нижняя панель (Кнопки и Прогресс) === -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <!-- Для кнопок слева -->
                <ColumnDefinition Width="*" />
                <!-- Пустое пространство посередине -->
                <ColumnDefinition Width="Auto" />
                <!-- Для прогресса справа -->
            </Grid.ColumnDefinitions>

            <!-- Группа кнопок слева -->
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="Load files" Command="{Binding LoadFileCommand}" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Export" Command="{Binding ExportFileCommand}" Padding="15,8" Margin="0,0,10,0"/>
                <Button Content="Cancel" Command="{Binding CancelCommand}" Padding="15,8"/>
            </StackPanel>

            <!-- Группа прогресса справа -->
            <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                <!-- Текст над баром -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,5">
                    <TextBlock Text="{Binding Progress, StringFormat=Обработано файлов: {0}}" />
                    <TextBlock x:Name="Cancelled" Text=" (отменено)" Foreground="Red" Margin="5,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Cancelled">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <!-- Сам бар -->
                <ProgressBar Minimum="0" Maximum="{Binding TotalFiles}" Value="{Binding Progress}" Height="15" Width="220" />
            </StackPanel>
        </Grid>

    </Grid>
</Window>