<Window x:Class="FolderContentExporter.View.ExportDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FolderContentExporter.View"
        mc:Ignorable="d"
        Title="Export Settings" 
        SizeToContent="WidthAndHeight" 
        WindowStartupLocation="CenterOwner"
        MinWidth="350">

    <!-- Добавили Margin="10", чтобы рамка GroupBox не прилипала к краям окна -->
    <GroupBox Header="Include fields" Margin="10">

        <StackPanel Margin="10">
            <!-- Чекбоксы теперь без жестких отступов слева, просто аккуратно лежат друг под другом -->
            <CheckBox Content="File Name" Margin="0,5,0,0" IsChecked="{Binding IncludeFileName}" />
            <CheckBox Content="Size" Margin="0,5,0,0" IsChecked="{Binding IncludeSize}" />
            <CheckBox Content="Extension" Margin="0,5,0,0" IsChecked="{Binding IncludeExtension}" />
            <CheckBox Content="Path" Margin="0,5,0,0" IsChecked="{Binding IncludePath}" />
            <CheckBox Content="Created Date" Margin="0,5,0,0" IsChecked="{Binding IncludeCreatedDate}" />
            <CheckBox Content="Modified Date" Margin="0,5,0,0" IsChecked="{Binding IncludeModifiedDate}" />

            <!-- Для нижней строки с вводом имени файла используем Grid вместо StackPanel -->
            <!-- Это позволит полю ввода имени файла занимать всё свободное место (*) -->
            <Grid Margin="0,20,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Поле ввода имени (растянется) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Выбор формата (по размеру текста) -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Кнопка (по размеру текста) -->
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" 
                         Text="{Binding ExportFileName, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalContentAlignment="Center" 
                         Margin="0,0,10,0" 
                         Padding="2"/>

                <ComboBox Grid.Column="1" 
                          ItemsSource="{Binding ExportModes}" 
                          SelectedItem="{Binding SelectedExportMode}" 
                          VerticalContentAlignment="Center" 
                          Margin="0,0,10,0" 
                          MinWidth="80"/>

                <Button Grid.Column="2" 
                        Content="Export" 
                        Command="{Binding ExitCommand}" 
                        Padding="15,4"/>
            </Grid>

        </StackPanel>
    </GroupBox>
</Window>